# Planned integration contract, not a runnable app. Copy to ignored .env.
# Empty secrets must be supplied privately after provider approval.
APP_ENV=development
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=
ALLOWED_REGIONS=
US_STATE_ALLOWLIST=
ADULT_FEATURES_ENABLED=false
CALLS_ENABLED=false
CLIPS_ENABLED=false
LIVE_VIDEO_ENABLED=false
FREE_TEXT_MONTHLY_LIMIT=150
FREE_TEXT_DAILY_LIMIT=5
PAID_TEXT_MONTHLY_LIMIT=500
VOICE_MESSAGE_MAX_SECONDS=15
VOICE_NOTE_INPUT_MONTHLY_MINUTES=5
FREE_ACCOUNT_PILOT_CAP=200
USER_CAMERA_ENABLED=false

# Cloudflare: management token for deployment/REST probes, never the browser.
# Runtime bindings planned in future Wrangler config: AI, DB, ASSETS_BUCKET,
# ACCOUNT_SESSION. Bindings are resources, not environment-string credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_SFU_APP_ID=
CLOUDFLARE_SFU_APP_SECRET=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Exact Cloudflare hosted models; clean processing only until separately approved.
CF_TEXT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CF_TEXT_GUARD_MODEL=@cf/meta/llama-guard-3-8b
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CF_ASR_MODEL=@cf/deepgram/flux
CF_TTS_MODEL=@cf/deepgram/aura-2-en
CF_FREE_VOICE_MODEL=@cf/myshell-ai/melotts

# MVP hosted portrait clips: approved non-explicit scripts only.
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/flashhead
VIDEO_MAX_DELIVERED_SECONDS=15
VIDEO_DELIVERY_TARGET_SECONDS=20
VIDEO_COST_BUDGET_USD=0.15

# Approved clean-business checkout candidate; no merchant account provisioned.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CALLS=
STRIPE_PRICE_CALLS_VIDEO=
STRIPE_PRICE_COMPANION_PLUS=
STRIPE_PRICE_VIDEO_PACK=
STRIPE_PRICE_PHONE_PACK=

# Optional custom compute beta; access and deployment schema unconfirmed.
RUNWARE_API_KEY=

# Manually provisioned GPU controller; no cloud management key needed at runtime.
# Shared server secret mints/verifies short-lived, account/session-bound grants.
GPU_SESSION_BASE_URL=
GPU_SESSION_SIGNING_SECRET=
GPU_CLIP_BASE_URL=
GPU_CLIP_SIGNING_SECRET=
GPU_LLM_MODEL=Qwen/Qwen3-8B
GPU_ASR_MODEL=Systran/faster-whisper-small
GPU_TTS_MODEL=hexgrad/Kokoro-82M
# Historical benchmark only; NOT the MVP runtime. Live video stays disabled.
GPU_AVATAR_MODEL=Quark-Vision/Live-Avatar
GPU_AVATAR_VERSION=v1.1
GPU_AVATAR_BASE_MODEL=Wan-AI/Wan2.2-S2V-14B
GPU_AVATAR_CODE_REVISION=
GPU_AVATAR_CHECKPOINT_REVISION=
GPU_ALLOCATED_COUNT=8
GPU_PIPELINE_COUNT=5
GPU_MAX_CONCURRENT_CALLS=1
# Challenger requires its own measured streaming integration.
GPU_CHALLENGER_MODEL=Soul-AILab/SoulX-FlashHead-1_3B
GPU_CHALLENGER_VARIANT=Model_Pro
GPU_CHALLENGER_AUDIO_MODEL=facebook/wav2vec2-base-960h
GPU_VAD_MODEL=snakers4/silero-vad
GPU_ADULT_AUX_BASE_URL=
GPU_ADULT_AUX_SIGNING_SECRET=
GPU_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
# Required deployment manifest path: exact revisions, hashes and dependency licenses.
MODEL_MANIFEST_PATH=

# CCBill hosted FlexForms + reconciliation; merchant approval required.
# Map to clientAccnum, clientSubacc, form ID and documented pricing salt.
CCBILL_ACCOUNT_NUMBER=
CCBILL_SUBACCOUNT_NUMBER=
CCBILL_FLEXFORM_ID=
CCBILL_DYNAMIC_PRICING_SALT=
CCBILL_DATALINK_USERNAME=
CCBILL_DATALINK_PASSWORD=

# Yoti hosted Age Verification Service; SDK ID -> Yoti-SDK-Id header.
YOTI_API_KEY=
YOTI_SDK_ID=
YOTI_AGE_API_BASE_URL=https://age.yoti.com/api/v1
YOTI_CALLBACK_URL=
YOTI_NOTIFICATION_URL=

# Transactional sign-in email; no intimate conversation content in emails.
RESEND_API_KEY=
EMAIL_FROM=
