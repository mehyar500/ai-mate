# Opt-in product scheduling, not an active automation in this repository.
CHECKINS_ENABLED=false
PROACTIVE_MEDIA_ENABLED=false
MAX_PAID_CHECKINS_PER_DAY=1
MAX_FREE_CHECKINS_PER_WEEK=1
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Internal or third-party method requires state/merchant acceptance.
# Budget includes a vendor fallback; no age verification is implemented.
AGE_VERIFICATION_MODE=disabled
AGE_VERIFICATION_BASE_URL=
AGE_VERIFICATION_SIGNING_SECRET=

# CCBill: only after whole-business approval. Validate documented events.
CCBILL_ACCOUNT_NUMBER=
CCBILL_SUBACCOUNT_NUMBER=
CCBILL_FLEXFORM_ID=
CCBILL_DYNAMIC_PRICING_SALT=
CCBILL_DATALINK_USERNAME=
CCBILL_DATALINK_PASSWORD=

# Yoti age verification; method/state eligibility requires review.
YOTI_API_KEY=
YOTI_SDK_ID=
YOTI_AGE_API_BASE_URL=https://age.yoti.com/api/v1
YOTI_CALLBACK_URL=
YOTI_NOTIFICATION_URL=

# Neutral transactional mail, subject to business eligibility.
RESEND_API_KEY=
EMAIL_FROM=
