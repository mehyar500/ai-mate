# Local startup choices, loaded by local_app/engine.py. Process/launcher overrides win.
AI_MATE_LLM_PROVIDER=cloudflare
# Blank selects the provider default: Cloudflare Qwen3-30B-A3B-FP8.
AI_MATE_LLM_MODEL=
# Only Cloudflare credential fields are read from this explicitly selected file.
# Relative paths resolve beside this .env; use a private absolute path if preferred.
AI_MATE_ENV_FILE=.env

# Optional optimized decoder. Keep torch until a locally built TensorRT engine
# has passed review and is installed in .cache/local-poc/musetalk-vae-trt/.
# Missing/mismatched selected engines fail video warm-up; voice/text remain available.
AI_MATE_VISUAL_DECODER=torch

# Optional GPU speech recognition after qualifying the local CUDA/cuDNN runtime.
# cpu uses Whisper Base EN int8; cuda uses the same weights in FP16 and warms at startup.
# An unavailable explicitly selected GPU fails startup; set cpu and restart to recover.
AI_MATE_ASR_DEVICE=cpu
# Optional CUDA recognizer warm-up using fixed local audio during the existing
# 650ms speech pause. Experimental until qualified; 0 disables it on restart.
AI_MATE_ASR_PAUSE_WARM=0

# Optional same-voice GPU speech after qualifying the isolated CUDA 12.8 runtime.
# Install config/speech-gpu-benchmark-requirements.txt into .cache/ort-gpu-deps.
# Missing/wrong runtime fails startup; set cpu and restart to recover.
AI_MATE_TTS_DEVICE=cpu

# Required for Cloudflare; populate here only when AI_MATE_ENV_FILE=.env.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
# Alternative authentication. API key + email takes precedence when both are present.
CLOUDFLARE_API_TOKEN=

# Optional MiniMax: set MINIMAX_API_KEY in the PROCESS environment, not this file.
# AI_MATE_LLM_PROVIDER=minimax selects that adapter; no silent provider fallback.
# Graphics/voice: LTX 2B 0.9.8 + MuseTalk 1.5, Kokoro 82M, Whisper base.en.
# These are pinned by local adapters and config/local-poc-requirements.txt, not fake env flags.
# The engine splits call speech into phrases and prepares one speech phrase ahead;
# body actions run once and listening-loop time continues. No additional keys/settings.
# Direct Diffusers and live LTX-2.3 inference remain benchmarks.
# FlashHead Lite is an isolated benchmark (about 5GB measured tensor allocation),
# not an enabled renderer. Cloudflare Aura-1/Aura-2/Melo speech comparisons use
# these same credentials only in benchmark scripts; local Kokoro remains selected.
# check_cloud_gateway.py uses these credentials for a read-only credit check.
# Third-party Cloudflare AI catalog models require separate Unified Billing credits.
# No additional provider key or remote-video runtime selector is configured yet.
# Reviewed LTX-2.3 base/near listening videos and approach/return/wave movements are
# prepared offline. The engine selects only hash-matched, reviewed manifests in
# generated/local-app (performance.json, performance-wave.json,
# performance-near-wave.json, idle-fullbody.json, idle-near.json).
# Up to six bounded sources are primed before the first call.
# They add no idle diffusion or env selector; unknown poses use held frames.
# HTTP 8765 and motion 8188 stay loopback-only; no public access/billing/age gate is implemented.
# Model choices, flow, measurements and deferred deployment needs: docs/LOCAL_POC.md.
