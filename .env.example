# Local runtime reads these three PROCESS environment variables (not this file).
# Default stays local. To free the GPU for graphics, choose minimax explicitly.
# MiniMax receives conversation text, recent context and saved notes; no audio/video.
AI_MATE_LLM_PROVIDER=ollama
AI_MATE_LLM_MODEL=
MINIMAX_API_KEY=
# minimax defaults to MiniMax-M2.7; MiniMax-M2.7-highspeed is an optional paid variant.
# No Codex session-token proxy or secret credentials are built into the app.

# Future deployment settings below are not read by the local prototype.
# Local app: .venv/Scripts/python.exe -m local_app.server, http://127.0.0.1:8765.
# Runtime defaults live in local_app/models.py and conversation.py; see docs/LOCAL_POC.md.
# These flags do not implement production access controls. Secrets stay private.
APP_ENV=development
PROJECT_STAGE=local_poc
DEMO_LOOPBACK_ONLY=true
PUBLIC_SIGNUP_ENABLED=false
PUBLIC_ADULT_ACCESS_ENABLED=false
BILLING_ENABLED=false
# Planning values only; there is no implemented spend controller.
POC_QUARTER_SPEND_CAP_USD=100
POC_CONTINGENCY_USD=75
REMOTE_INFERENCE_ENABLED=false
LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen3.5:9b-q4_K_M
LOCAL_MODEL_DIR=.cache/local-poc
LOCAL_TTS_DEVICE=cpu
APP_ORIGIN=http://127.0.0.1:8765
SESSION_SECRET=
US_STATE_ALLOWLIST=
# Product requirement is mandatory; runtime access remains off until gates pass.
# Planned settings only: no application currently reads or enforces these.
PRODUCT_ADULT_CONTENT_REQUIRED=true
ADULT_CAPABILITY_EVIDENCE_PATH=
ADULT_PROVIDER_APPROVAL_REFERENCE=
ADULT_PROCESSOR_APPROVAL_REFERENCE=
ADULT_FEATURES_ENABLED=false
CALLS_ENABLED=false
CLIPS_ENABLED=false
LIVE_VIDEO_ENABLED=false
GENERAL_VIDEO_ENABLED=false
USER_CAMERA_ENABLED=false

# Planned Cloudflare bindings: DB, ASSETS_BUCKET, ACCOUNT_SESSION, JOBS.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_SFU_APP_ID=
CLOUDFLARE_SFU_APP_SECRET=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Neutral public/product tasks only; never companion transcripts or memory.
NEUTRAL_AI_ENABLED=false
NEUTRAL_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
NEUTRAL_AI_MONTHLY_BUDGET_USD=20

# Manually approved/provisioned US inference service; no browser secrets.
GPU_SESSION_BASE_URL=
GPU_SESSION_SIGNING_SECRET=
GPU_CLIP_BASE_URL=
GPU_CLIP_SIGNING_SECRET=
GPU_AUX_BASE_URL=
GPU_AUX_SIGNING_SECRET=
GPU_REGION=
GPU_PROVIDER_APPROVAL_REFERENCE=
GPU_PROVIDER_API_KEY=
GPU_MONTHLY_COMPUTE_BUDGET_USD=
GPU_MIN_PREPAID_RUNWAY_USD=
GPU_AVATAR_MODEL=Soul-AILab/SoulX-FlashHead-1_3B
GPU_AVATAR_VARIANT=Model_Lite
GPU_AVATAR_VAE=VAE_LTX
GPU_AVATAR_AUDIO_MODEL=facebook/wav2vec2-base-960h
GPU_LLM_MODEL=Qwen/Qwen3-8B
GPU_LLM_THINKING_ENABLED=false
GPU_ASR_MODEL=Systran/faster-whisper-small
GPU_TTS_MODEL=hexgrad/Kokoro-82M
GPU_VAD_MODEL=snakers4/silero-vad
GPU_GUARD_MODEL=meta-llama/Llama-Guard-3-8B
GPU_PORTRAIT_MODEL=black-forest-labs/FLUX.2-klein-4B
GPU_SCENE_MODEL=black-forest-labs/FLUX.2-klein-4B
