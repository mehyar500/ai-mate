SCENE_COST_BUDGET_USD=0.10
SCENE_MAX_ATTEMPTS=2
SCENE_READY_TTL_SECONDS=120
MODEL_MANIFEST_PATH=
# One stream until full-pipeline concurrency measurement passes.
GPU_MAX_CONCURRENT_CALLS=1
LIVE_VIDEO_TARGET_FPS=25
LIVE_REPLY_P95_TARGET_MS=2000
MAX_PROMPT_TOKENS=4096
FREE_TEXT_MONTHLY_LIMIT=150
FREE_TEXT_DAILY_LIMIT=5
PAID_TEXT_MONTHLY_LIMIT=500
VOICE_MESSAGE_MAX_SECONDS=15
VOICE_NOTE_INPUT_MONTHLY_MINUTES=5
FREE_ACCOUNT_PILOT_CAP=25
VIDEO_MAX_DELIVERED_SECONDS=15
# Output duration and time to deliver are different; targets are unmeasured.
PORTRAIT_VIDEO_DELIVERY_TARGET_SECONDS=15
PORTRAIT_VIDEO_COST_BUDGET_USD=0.15
# Separate research candidate; no general-video entitlement is sold.
GPU_GENERAL_VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B
GPU_GENERAL_VIDEO_BASE_URL=
GPU_GENERAL_VIDEO_SIGNING_SECRET=
GENERAL_VIDEO_COST_BUDGET_USD=1.25
