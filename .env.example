# ==========================================
# AMORI SYSTEM ENVS - MASTER TEMPLATE
# ==========================================

# 1. CLOUDFLARE (Edge, DB, WebRTC)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_here"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token_here"
# Cloudflare Calls (WebRTC)
CLOUDFLARE_CALLS_APP_ID="your_calls_app_id_here"
CLOUDFLARE_CALLS_APP_SECRET="your_calls_app_secret_here"

# 2. RUNPOD (Serverless GPU Inference)
RUNPOD_API_KEY="your_runpod_personal_api_key_here"
# Endpoint IDs for designated models
RUNPOD_ENDPOINT_LLM="your_dolphin_llama3_endpoint_id"
RUNPOD_ENDPOINT_TTS="your_xttsv2_endpoint_id"
RUNPOD_ENDPOINT_VIDEO="your_liveportrait_endpoint_id"

# 3. APPLICATION & SECURITY
ENVIRONMENT="development" # ENUM: development | staging | production
APP_SECRET_KEY="generate_a_random_secure_hex_key_here"
CORS_ALLOWED_ORIGINS="https://yourdomain.com,http://localhost:3000"

# 4. EXTERNAL APIs & TELEMETRY
# Placeholder for additional integrations (e.g. Turn/Stun external overriding)
TELEMETRY_KEY=""
